# ================================
# StayRide Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ================================

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stayride_dev
DB_USER=stayride
DB_PASSWORD=dev_password
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_very_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_very_long
JWT_REFRESH_EXPIRES=30d

# Cloudinary (stockage images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase FCM (notifications push)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Email (Mailgun)
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.stayride.cm
MAIL_FROM=noreply@stayride.cm
MAIL_FROM_NAME=StayRide

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# PayPal
PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxx
PAYPAL_MODE=sandbox

# Platform
PLATFORM_COMMISSION_RATE=10
PLATFORM_NAME=StayRide
PLATFORM_CURRENCY=XAF

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
